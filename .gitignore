# ==========================================
# 1. DEPENDENCIAS (Node.js / Monorepo)
# ==========================================
node_modules/
/backend/node_modules/
/frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# 2. SEGURIDAD EXTREMA (Variables de Entorno y Secretos)
# ==========================================
# Bloquear CUALQUIER archivo que contenga credenciales o llaves
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
certs/

# Opcional: Si en tus archivos .http guardas contraseñas reales en lugar de variables,
# descomenta la línea de abajo para evitar subirlos.
# *.http

# ==========================================
# 3. COMPILACIÓN Y ARCHIVOS DE SALIDA (Build Artifacts)
# ==========================================
/backend/dist/
/frontend/dist/
/frontend/build/
.cache/
.parcel-cache/
.eslintcache
.prettiercache

# ==========================================
# 4. TESTING (Cobertura y Reportes de Vitest)
# ==========================================
coverage/
/backend/coverage/
/frontend/coverage/
.nyc_output/
html-report/

# ==========================================
# 5. ENTORNOS VIRTUALES Y DOCKER (Datos locales persistentes)
# ==========================================
# Ignoramos la carpeta de datos de postgres local para que no sature Git
.docker-data/
pgdata/
*.db
*.sqlite

# ==========================================
# 6. CONFIGURACIONES DE IDEs Y SISTEMA OPERATIVO
# ==========================================
# Editores
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Basura específica de Windows (ya que trabajas en Windows)
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Basura de macOS (por si algún colega usa Mac en el futuro)
.DS_Store
.AppleDouble
.LSOverride
